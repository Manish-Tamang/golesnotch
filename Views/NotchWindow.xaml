<Window x:Class="Notch.Views.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Notch.Controls"
        Title="Notch"
        Width="760" Height="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        UseLayoutRounding="True"
        FontFamily="{StaticResource TextFont}"
        Foreground="White">

    <!--
      The window is a fixed, fully transparent box at the top-centre of the screen.
      Windows lets clicks on transparent pixels fall through to whatever is behind,
      so only the black island is "solid".

      The island never changes its layout size. Its black body (IslandBody) is a rounded
      rectangle that moves on springs and also clips ContentHost. The views below are
      stacked; the one that matches the current mode is faded in.
    -->
    <Grid x:Name="Island" Width="720" Height="370"
          HorizontalAlignment="Center" VerticalAlignment="Top"
          MouseEnter="Island_MouseEnter"
          MouseLeave="Island_MouseLeave"
          MouseLeftButtonUp="Island_MouseLeftButtonUp"
          MouseWheel="Island_MouseWheel">

        <c:IslandShape x:Name="IslandBody"/>

        <Grid x:Name="ContentHost">

            <!-- Closed: a small pill -->
            <Grid x:Name="CollapsedView" Width="168" Height="32"
                  HorizontalAlignment="Center" VerticalAlignment="Top">

                <!-- Usual content: [battery ring or album cover] [clock] [equalizer bars] -->
                <Grid x:Name="PillStatus" Margin="10,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <c:ProgressRing x:Name="PillRing" Width="14" Height="14" Margin="1,0,0,0"
                                    VerticalAlignment="Center"/>
                    <Border x:Name="PillArt" Width="20" Height="20" CornerRadius="5"
                            VerticalAlignment="Center"
                            Background="{StaticResource PlaceholderBrush}" Visibility="Collapsed"/>

                    <TextBlock x:Name="PillText" Grid.Column="1" Margin="6,0,0,0"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>

                    <c:EqBars x:Name="PillBars" Grid.Column="2" Margin="6,0,0,0" Visibility="Collapsed"/>
                </Grid>

                <!-- While lyrics are on: the line being sung -->
                <Grid x:Name="PillLyrics" Margin="14,0,14,0" Visibility="Collapsed">
                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <c:LyricTicker x:Name="PillLyricLine" Margin="26,0,26,0"/>
                </Grid>
            </Grid>

            <!-- Popup: a status banner, the volume bar or a notification card (added in code) -->
            <Grid x:Name="HudView" Width="380"
                  HorizontalAlignment="Center" VerticalAlignment="Top"
                  RenderTransformOrigin="0.5,0" Opacity="0" IsHitTestVisible="False"/>

            <!-- Open: the pages (added in code), one visible at a time, each centred -->
            <Grid x:Name="ExpandedView" VerticalAlignment="Top"
                  RenderTransformOrigin="0.5,0" Opacity="0" IsHitTestVisible="False">
                <Grid x:Name="PageHost"/>
            </Grid>

            <!-- Page dots, kept just above the island's bottom edge by a transform -->
            <c:PageDots x:Name="Dots" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Opacity="0" IsHitTestVisible="False"/>

            <!-- Page icons, which replace the dots while the mouse is over them -->
            <c:PageTabs x:Name="Tabs" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Opacity="0" IsHitTestVisible="False"/>
        </Grid>
    </Grid>
</Window>
