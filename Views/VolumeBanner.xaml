<UserControl x:Class="Notch.Views.VolumeBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="40">

    <!-- The volume popup: a speaker icon and a bar that follows the level. -->
    <Grid Margin="20,0,24,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="26"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="Icon" FontFamily="{StaticResource IconFont}" FontSize="17"
                   VerticalAlignment="Center"/>

        <Grid x:Name="Track" Grid.Column="1" Height="5" Margin="10,0,0,0" VerticalAlignment="Center">
            <Border CornerRadius="2.5" Background="#33FFFFFF"/>
            <Border x:Name="Fill" CornerRadius="2.5" Background="White" HorizontalAlignment="Left" Width="0"/>
        </Grid>
    </Grid>
</UserControl>
