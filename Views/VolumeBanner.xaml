<UserControl x:Class="Notch.Views.VolumeBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Notch.Controls"
             Height="40">
    <!-- The volume or brightness popup: an icon and a bar you can drag. -->
    <Grid Margin="20,0,24,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="26"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Icon" FontFamily="{StaticResource IconFont}" FontSize="17"
                   VerticalAlignment="Center"/>
        <c:LevelSlider x:Name="Slider" Grid.Column="1" TrackHeight="5" Margin="10,0,0,0"
                       VerticalAlignment="Center"/>
    </Grid>
</UserControl>
