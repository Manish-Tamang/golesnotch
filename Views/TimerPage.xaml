<v:NotchPage x:Class="Notch.Views.TimerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Notch.Controls"
             xmlns:v="clr-namespace:Notch.Views">
    <Grid Margin="22,16,20,0" Height="104" VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Countdown inside a ring -->
        <Grid Width="100" Height="100" VerticalAlignment="Center">
            <c:ProgressRing x:Name="Ring" StrokeWidth="6"/>
            <TextBlock x:Name="TimeText" FontFamily="{StaticResource DisplayFont}" FontSize="23"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Typography.NumeralAlignment="Tabular"/>
        </Grid>

        <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="StateText" Text="Focus timer" FontSize="14" FontWeight="SemiBold"/>

            <!-- Session length, in minutes -->
            <StackPanel x:Name="Presets" Orientation="Horizontal" Margin="0,9,0,0">
                <RadioButton Style="{StaticResource Chip}" Content="15 min" Tag="15" Click="Preset_Click"/>
                <RadioButton Style="{StaticResource Chip}" Content="25 min" Tag="25" Click="Preset_Click"/>
                <RadioButton Style="{StaticResource Chip}" Content="45 min" Tag="45" Click="Preset_Click"/>
                <RadioButton Style="{StaticResource Chip}" Content="60 min" Tag="60" Click="Preset_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="StartButton" Style="{StaticResource PillButton}" Content="Start"
                        MinWidth="72" Click="Start_Click"/>
                <Button Style="{StaticResource PillButtonSecondary}" Content="Reset" Margin="8,0,0,0"
                        Click="Reset_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</v:NotchPage>
