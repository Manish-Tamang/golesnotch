<v:NotchPage x:Class="Notch.Views.NotificationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Notch.Views">
    <Grid VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="20,12,12,0">
            <TextBlock x:Name="HeaderText" Text="Notifications" FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <Button x:Name="ClearButton" Style="{StaticResource TextButton}" Content="Clear all"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="Clear_Click"/>
        </Grid>

        <!-- The list scrolls with the mouse wheel when it is taller than the page -->
        <ScrollViewer x:Name="Scroller" Grid.Row="1" MaxHeight="232" Focusable="False"
                      VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="CardList"/>
        </ScrollViewer>

        <!-- Shown instead of the list: empty, or no access -->
        <StackPanel x:Name="MessagePanel" Grid.Row="1" Margin="28,8,28,14" Visibility="Collapsed">
            <TextBlock x:Name="MessageText" FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                       TextAlignment="Center" TextWrapping="Wrap"/>
            <Button x:Name="AccessButton" Style="{StaticResource PillButtonSecondary}"
                    Content="Open Windows settings" HorizontalAlignment="Center" Margin="0,10,0,0"
                    Click="Access_Click"/>
        </StackPanel>
    </Grid>
</v:NotchPage>
