<v:NotchPage x:Class="Notch.Views.MusicPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Notch.Controls"
             xmlns:v="clr-namespace:Notch.Views">
    <Grid>

        <!-- ===== Something is playing =====
             Two columns: the player, and (when lyrics are on) the lyrics beside it.
             The column widths are switched in code; see MusicPage.ApplyLyricsLayout. -->
        <Grid x:Name="MediaPanel" Margin="20,14,20,0" HorizontalAlignment="Left" VerticalAlignment="Top"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PlayerColumn" Width="400"/>
                <ColumnDefinition x:Name="LyricsColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>    <!-- cover, date and time, title -->
                    <RowDefinition Height="30"/>    <!-- progress -->
                    <RowDefinition Height="38"/>    <!-- controls -->
                </Grid.RowDefinitions>

                <Border x:Name="Art" Width="60" Height="60" CornerRadius="12"
                        HorizontalAlignment="Left" Background="{StaticResource PlaceholderBrush}"/>

                <StackPanel x:Name="TitleStack" Margin="74,0,0,0" VerticalAlignment="Bottom">
                    <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}"
                               FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ArtistText" FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,1,0,2"/>
                </StackPanel>

                <!-- Centred on the notch, above the title. Hidden while lyrics are beside the player. -->
                <Grid x:Name="Header" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <c:ProgressRing x:Name="BatteryRing" Width="13" Height="13" Margin="0,0,7,0"
                                        VerticalAlignment="Center"/>
                        <TextBlock x:Name="DateText" FontSize="12.5" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TimeText" FontSize="12.5" FontWeight="SemiBold" Margin="6,0,0,0"
                                   VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>
                    <c:EqBars x:Name="Bars" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                </Grid>

                <!-- Progress: click anywhere on the bar to jump there -->
                <Grid Grid.Row="1" Height="16" VerticalAlignment="Bottom" Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ElapsedText" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>

                    <Grid x:Name="SeekArea" Grid.Column="1" Background="Transparent" Cursor="Hand"
                          MouseLeftButtonDown="SeekArea_MouseLeftButtonDown">
                        <Border Height="4" CornerRadius="2" Background="#33FFFFFF" VerticalAlignment="Center"/>
                        <Border x:Name="ProgressFill" Height="4" CornerRadius="2" Background="White"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Width="0"/>
                    </Grid>

                    <TextBlock x:Name="RemainingText" Grid.Column="2" FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                </Grid>

                <!-- Controls -->
                <Grid Grid.Row="2" VerticalAlignment="Bottom">
                    <Button x:Name="LyricsButton" Style="{StaticResource IconButton}" Width="36"
                            HorizontalAlignment="Left" Margin="-9,0,0,0" Click="Lyrics_Click">
                        <Path x:Name="LyricsIcon" Data="{StaticResource LyricsGlyph}" Fill="White" Opacity="0.7"
                              Width="16" Height="15" Stretch="Uniform"/>
                    </Button>

                    <Button Style="{StaticResource IconButton}" Width="36"
                            HorizontalAlignment="Right" Margin="0,0,-9,0" Click="Mute_Click">
                        <TextBlock x:Name="VolumeIcon" FontFamily="{StaticResource IconFont}" FontSize="15"
                                   Opacity="0.7"/>
                    </Button>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Click="Previous_Click">
                            <Path Data="{StaticResource PreviousGlyph}" Style="{StaticResource GlyphPath}"
                                  Width="17" Height="12"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="PlayPause_Click" Margin="14,0">
                            <Path x:Name="PlayPauseIcon" Data="{StaticResource PlayGlyph}"
                                  Style="{StaticResource GlyphPath}" Width="13" Height="15"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="Next_Click">
                            <Path Data="{StaticResource NextGlyph}" Style="{StaticResource GlyphPath}"
                                  Width="17" Height="12"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Lyrics, to the right of the player, behind a thin divider -->
            <Grid x:Name="LyricsSide" Grid.Column="1" Height="128" VerticalAlignment="Top"
                  Visibility="Collapsed">
                <Rectangle Width="1" Fill="#24FFFFFF" HorizontalAlignment="Left" Margin="16,4,0,4"/>
                <c:LyricsView x:Name="LyricsPanel" Margin="34,0,0,0"/>
            </Grid>
        </Grid>

        <!-- ===== Nothing is playing ===== -->
        <StackPanel x:Name="IdlePanel" VerticalAlignment="Top">
            <TextBlock x:Name="IdleTime" FontFamily="{StaticResource DisplayFont}" FontSize="38"
                       FontWeight="Light" HorizontalAlignment="Center" Margin="0,12,0,0"
                       Typography.NumeralAlignment="Tabular"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                <c:ProgressRing x:Name="IdleRing" Width="12" Height="12" Margin="0,0,7,0"
                                VerticalAlignment="Center"/>
                <TextBlock x:Name="IdleDate" FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="IdleBattery" FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</v:NotchPage>
