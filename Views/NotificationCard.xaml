<UserControl x:Class="Notch.Views.NotificationCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- One notification. Click it to enlarge; the enlarged card shows the whole
         message and the Open / Dismiss buttons. -->
    <Border x:Name="Surface" Margin="6,0" CornerRadius="16" Cursor="Hand"
            MouseLeftButtonUp="Surface_MouseLeftButtonUp">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#12FFFFFF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid Margin="12,10,14,11">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- App icon, or the app's first letter when it has none -->
            <Grid Width="26" Height="26" VerticalAlignment="Top" Margin="0,8,0,0">
                <Border x:Name="IconFallback" CornerRadius="7" Background="#2C2C2E">
                    <TextBlock x:Name="IconLetter" FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Image x:Name="IconImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <Grid>
                    <TextBlock x:Name="AppText" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,44,0"/>
                    <TextBlock x:Name="TimeText" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Right"/>
                </Grid>
                <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}" FontSize="15"
                           FontWeight="SemiBold" Margin="0,1,0,0"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="BodyText" FontSize="12.5" Foreground="#99FFFFFF" Margin="0,1,0,0"
                           TextTrimming="CharacterEllipsis"/>

                <StackPanel x:Name="Actions" Orientation="Horizontal" Margin="0,10,0,2" Visibility="Collapsed">
                    <Button Style="{StaticResource PillButton}" Content="Open" Click="Open_Click"/>
                    <Button Style="{StaticResource PillButtonSecondary}" Content="Dismiss" Margin="8,0,0,0"
                            Click="Dismiss_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
