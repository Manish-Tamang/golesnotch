---
import { Font } from "astro:assets"
import "../styles/site.css"
import Notch from "../components/Notch.astro"
import { repo, downloads } from "../data/release"

interface Props {
  title?: string
  description?: string
}

const {
  title = "Notch for Windows",
  description = "A small, animated notch for the top of your Windows screen. Music with synced lyrics, a file shelf, notifications and a focus timer, on a real spring. Native, free, MIT licensed.",
} = Astro.props
const path = Astro.url.pathname.replace(/\/$/, "") || "/"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-inter" preload={[{ style: "normal", subset: "latin" }]} />
  </head>
  <body>
    <Notch />

    <div class="page">
      <header class="bar">
        <a class="logo" href="/">Notch</a>
        <nav class="nav" aria-label="Site">
          <a class="navlink hide-sm" href={`${repo}#readme`}>Docs</a>
          <a class="navlink" href="/changelog" aria-current={path === "/changelog" ? "page" : undefined}
            >Changelog</a
          >
          <a class="navlink hide-sm" href={downloads.all}>Releases</a>
          <a class="gh" href={repo}
            ><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor">
              <path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"
              ></path></svg
            ><span>Star on GitHub</span></a
          >
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer>
        <span>Made by <a href="https://manishtamang.com">manishtamang.com</a></span>
        <span>MIT licensed · No telemetry, no account</span>
      </footer>
    </div>
  </body>
</html>
