<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared look of the notch: fonts, colours, icons and button styles. -->

    <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <!-- The icon font built into Windows: Fluent on 11, MDL2 on 10. -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Replaced at runtime by Theme.ApplyAccent; use it through DynamicResource. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#30D158"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8CFFFFFF"/>
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#262626"/>

    <!-- Icons, drawn as shapes so they stay crisp at any display scale. -->
    <Geometry x:Key="PlayGlyph">M1,0 L13,7 L1,14 Z</Geometry>
    <Geometry x:Key="PauseGlyph">M0,0 H4 V14 H0 Z M9,0 H13 V14 H9 Z</Geometry>
    <Geometry x:Key="NextGlyph">M0,0 L8,6 L0,12 Z M8,0 L16,6 L8,12 Z</Geometry>
    <Geometry x:Key="PreviousGlyph">M16,0 L8,6 L16,12 Z M8,0 L0,6 L8,12 Z</Geometry>
    <Geometry x:Key="LyricsGlyph">F0 M2,0 H14 A2,2 0 0 1 16,2 V9 A2,2 0 0 1 14,11 H7 L3,14.5 V11 H2 A2,2 0 0 1 0,9 V2 A2,2 0 0 1 2,0 Z M4,3 H12 V4.6 H4 Z M4,6.4 H9.5 V8 H4 Z</Geometry>
    <Geometry x:Key="BoltGlyph">M9,0 L1,9 H6.5 L5,16 L13,6.5 H7.5 Z</Geometry>
    <Geometry x:Key="BatteryGlyph">F0 M0,2 H13 V4.5 H15 V7.5 H13 V10 H0 Z M1.5,3.5 V8.5 H11.5 V3.5 Z M3,5 H6 V7 H3 Z</Geometry>
    <Geometry x:Key="CheckGlyph">M0,7 L2,5 L5.5,8.5 L12,1.5 L14,3.5 L5.5,12.5 Z</Geometry>

    <!-- Solid playback icons with slightly rounded corners. -->
    <Style x:Key="GlyphPath" TargetType="Path">
        <Setter Property="Fill" Value="White"/>
        <Setter Property="Stroke" Value="White"/>
        <Setter Property="StrokeThickness" Value="1.4"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Stretch" Value="Uniform"/>
    </Style>

    <!-- Round button that holds an icon. -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="18"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#1CFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                            <Setter TargetName="Bg" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- White pill button with text: the main action. -->
    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="14"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.86"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Translucent pill button: the secondary action. -->
    <Style x:Key="PillButtonSecondary" TargetType="Button" BasedOn="{StaticResource PillButton}">
        <Setter Property="Background" Value="#26FFFFFF"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <!-- Plain text button, for low-key actions like "Clear all". -->
    <Style x:Key="TextButton" TargetType="Button">
        <Setter Property="Foreground" Value="#8CFFFFFF"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="6,3">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A clickable tile (the Wi-Fi and Bluetooth switches). -->
    <Style x:Key="Tile" TargetType="Border">
        <Setter Property="Background" Value="#14FFFFFF"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#22FFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Small choice chip (timer lengths). One per group is selected. -->
    <Style x:Key="Chip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#B3FFFFFF"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" Background="#1AFFFFFF" CornerRadius="11" Height="22" Padding="10,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#2EFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="Black"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
